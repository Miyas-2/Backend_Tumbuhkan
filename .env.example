# Database Configuration - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=tumbuhkan_db

# MQTT Configuration
MQTT_BROKER=broker.mqtt.cool
MQTT_PORT=1883
MQTT_SAVE_INTERVAL=30

# MQTT Topics (optional - has default values)
# MQTT_TOPIC_SENSOR=tumbuhkan/sensor/data
# MQTT_TOPIC_RELAY_CONTROL=tumbuhkan/relay/control
# MQTT_TOPIC_RELAY_STATUS=tumbuhkan/relay/status
# MQTT_TOPIC_PH_CALIBRATION=tumbuhkan/ph/calibration
# MQTT_TOPIC_TDS_CALIBRATION=tumbuhkan/tds/calibration

# AI Services
GEMINI_API_KEY=your_gemini_api_key
HF_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HF_TOKEN=

# Application
APP_NAME=Tumbuhkan Backend
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api/v1

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
